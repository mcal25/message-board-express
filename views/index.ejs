<html>
    <head>
        <title>Message Board</title>
    </head>
    <body>
        <h1>Message Board</h1>
        <br>
        <a href="/new"><button>New</button></a>
        <br>
        <br>
        <% messages.forEach((message) => { %>
            <div>
                <h2><%= message.user %>:</h2>
                    <p><%= message.text %></p>
                    <p><%= message.added %></p>
                <a href="/<%= message.id %>"><button>Details</button></a>
            </div>
            <br>
        <% }) %>
    </body>
</html>